{
  "name": "rate-limiter-gateway",
  "version": "2.0.0",
  "description": "Distributed rate limiter / API gateway in TypeScript, factory pattern for pluggable algorithms, Prometheus metrics",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/algorithms/scripts && cp src/algorithms/scripts/*.lua dist/algorithms/scripts/",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "loadtest": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.4.1",
    "dotenv": "^16.4.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15"
  }
}
